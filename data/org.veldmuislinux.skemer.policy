<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>Veldmuis Linux</vendor>
  <vendor_url>https://veldmuislinux.org/</vendor_url>

  <action id="org.veldmuislinux.skemer.apply">
    <description>Update the system and Flatpak system apps</description>
    <message>Authentication is required to update the system</message>
    <icon_name>skemer</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.veldmuislinux.skemer.refresh-mirrors">
    <description>Refresh the Arch mirrorlist</description>
    <message>Authentication is required to refresh the Arch mirrorlist</message>
    <icon_name>skemer</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.veldmuislinux.skemer.manage-packages">
    <description>Install or remove packages</description>
    <message>Authentication is required to change installed packages</message>
    <icon_name>skemer</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.veldmuislinux.skemer.manage-repositories">
    <description>Change package repositories and pacman options</description>
    <message>Authentication is required to change repository settings</message>
    <icon_name>skemer</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
